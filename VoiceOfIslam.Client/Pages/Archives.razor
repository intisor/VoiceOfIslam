<div class="flex items-center gap-3 mt-1">
<span class="text-secondary font-light text-xs uppercase tracking-[0.05em]">Dr. Omar Suliman</span>
<span class="w-1 h-1 rounded-full bg-outline-variant"></span>
<span class="text-secondary font-light text-xs uppercase tracking-[0.05em]">32:15</span>
</div>
</div>
</div>
<div class="flex items-center gap-4 mt-4 md:mt-0 opacity-40 group-hover:opacity-100 transition-opacity">
<button class="material-symbols-outlined text-secondary hover:text-primary" data-icon="bookmark">bookmark</button>
<button class="material-symbols-outlined text-secondary hover:text-primary" data-icon="share">share</button>
<button class="w-10 h-10 rounded-full bg-primary/10 text-primary flex items-center justify-center" data-icon="play_arrow">
<span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">play_arrow</span>
</button>
</div>
</div>
<!-- Card 2 -->
<div class="bg-surface-container-lowest rounded-xl p-6 flex flex-col md:flex-row md:items-center justify-between hover:bg-surface-container-low transition-colors duration-300 group cursor-pointer border-none">
<div class="flex gap-6 items-center">
<div class="w-16 h-16 rounded-2xl bg-secondary-container flex items-center justify-center text-primary overflow-hidden">
