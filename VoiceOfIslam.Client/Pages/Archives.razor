@page "/archives"
@inject AudioPlayerService AudioPlayer
@inject LectureService LectureService
@inject NavigationManager NavigationManager
@inject MenuService MenuService
@inject IJSRuntime JS

<PageTitle>Archives - Ohun Islam</PageTitle>

<div class="grain-texture"></div>
<!-- Top App Bar -->
<header class="w-full pt-8 pb-4 flex items-center justify-between px-6 max-w-screen-xl mx-auto bg-[#fdf9f2] dark:bg-stone-950 sticky top-0 z-40">
<div class="flex items-center gap-4">
<button class="material-symbols-outlined text-[#416355] dark:text-[#6B8E7F] hover:opacity-80 transition-opacity bg-transparent border-none" @onclick="MenuService.ToggleMenu">menu</button>
<h1 class="font-['Manrope'] font-bold text-2xl tracking-tight text-[#416355] dark:text-[#6B8E7F]">Archives</h1>
</div>
<div class="flex items-center gap-4">
<button class="material-symbols-outlined text-[#416355] dark:text-[#6B8E7F] hover:opacity-80 transition-opacity" data-icon="search">search</button>
<div class="w-8 h-8 rounded-full bg-surface-container-high overflow-hidden border border-outline-variant/10">
<img class="w-full h-full object-cover" data-alt="Ohun Islam profile artwork" src="@(CoverArtHelper.CreateCoverUrl("Ohun Islam", "Sanctuary"))"/>
</div>
</div>
</header>
<main class="max-w-screen-xl mx-auto px-6 pb-40">
<!-- Filter Section -->
<section class="mt-6 mb-10 overflow-x-auto no-scrollbar">
<div class="flex items-center gap-3 whitespace-nowrap">
@foreach (var filter in Filters)
{
<button class="@GetFilterClass(filter) text-sm font-medium transition-colors hover:bg-surface-container-high" @onclick="() => CurrentFilter = filter">
    @filter
</button>
}
</div>
</section>
<!-- Featured / Stats Row (Editorial Layout) -->
<div class="grid grid-cols-1 md:grid-cols-12 gap-6 mb-12">
<div class="md:col-span-8 bg-surface-container-low rounded-3xl p-8 relative overflow-hidden group">
<div class="relative z-10">
<span class="label-md uppercase tracking-[0.1em] text-primary font-bold">Featured Archive</span>
<h2 class="text-3xl font-headline font-extrabold mt-4 mb-6 leading-tight max-w-md">The Journey of Faith: Navigating Modern Challenges</h2>
<div class="flex items-center gap-4">
<button class="bg-primary text-on-primary px-6 py-3 rounded-full flex items-center gap-2 font-bold hover:scale-105 transition-transform">
<span class="material-symbols-outlined" data-icon="play_arrow" style="font-variation-settings: 'FILL' 1;">play_arrow</span>
                            Listen Now
                        </button>
<span class="text-secondary text-sm font-medium">48 mins • July 2024</span>
</div>
</div>
<div class="absolute -right-10 -bottom-10 opacity-10 group-hover:opacity-20 transition-opacity">
<span class="material-symbols-outlined text-[200px]" data-icon="library_books">library_books</span>
</div>
</div>
<div class="md:col-span-4 bg-primary text-on-primary rounded-3xl p-8 flex flex-col justify-between">
<div>
<h3 class="text-4xl font-headline font-extrabold">@FilteredLectures.Count()</h3>
<p class="opacity-80 text-sm font-medium uppercase tracking-widest mt-1">Total Lectures</p>
</div>
<div class="pt-8">
<p class="text-sm italic opacity-90 leading-relaxed">@(FilteredLectures.FirstOrDefault()?.Description ?? "The heart finds rest in the remembrance of Allah.")</p>
</div>
</div>
</div>
<!-- Lecture List View -->
<div class="space-y-6 lecture-list">
@if (FilteredLectures.Count == 0)
{
<div class="rounded-xl border border-outline-variant/10 bg-surface-container-lowest p-6 text-secondary">
    No lectures match this filter.
</div>
}
else
{
    @foreach (var lecture in FilteredLectures)
    {
<div class="bg-surface-container-lowest rounded-xl p-6 flex flex-col md:flex-row md:items-center justify-between hover:bg-surface-container-low transition-colors duration-300 group cursor-pointer border-none" @onclick="() => PlayLectureAsync(lecture)">
<div class="flex gap-6 items-center">
<div class="w-16 h-16 rounded-2xl bg-secondary-container flex items-center justify-center text-primary overflow-hidden">
<img class="w-full h-full object-cover" alt="@lecture.Title" src="@CoverArtHelper.CreateCoverUrl(lecture.Title, lecture.Speaker)"/>
</div>
<div>
<h4 class="font-headline font-bold text-lg text-on-surface group-hover:text-primary transition-colors">@lecture.Title</h4>
<div class="flex items-center gap-3 mt-1">
<span class="text-secondary font-light text-xs uppercase tracking-[0.05em]">@lecture.Speaker</span>
<span class="w-1 h-1 rounded-full bg-outline-variant"></span>
<span class="text-secondary font-light text-xs uppercase tracking-[0.05em]">@FormatDuration(lecture.Duration)</span>
</div>
</div>
</div>
<div class="flex items-center gap-4 mt-4 md:mt-0 opacity-40 group-hover:opacity-100 transition-opacity">

<button class="material-symbols-outlined text-secondary hover:text-primary" @onclick="() => CopyLectureLinkAsync(lecture)" @onclick:stopPropagation="true">share</button>
<button class="w-10 h-10 rounded-full bg-primary/10 text-primary flex items-center justify-center" @onclick="() => PlayLectureAsync(lecture)" @onclick:stopPropagation="true">
<span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">play_arrow</span>
</button>
</div>
</div>
    }
}
</div>
</main>

@code {
    private List<AudioStream> Lectures { get; set; } = [];

    private string CurrentFilter { get; set; } = "All";

    private static readonly string[] Filters = ["All", "Live", "Faith", "History", "Speakers"];

    protected override async Task OnInitializedAsync()
    {
        Lectures = await LectureService.GetAllLectures();

    }

    private List<AudioStream> FilteredLectures => CurrentFilter switch
    {
        "Live" => Lectures.Where(lecture => lecture.IsLive).ToList(),
        "Faith" => Lectures.Where(lecture => lecture.Title.Contains("faith", StringComparison.OrdinalIgnoreCase) || lecture.Description.Contains("faith", StringComparison.OrdinalIgnoreCase)).ToList(),
        "History" => Lectures.Where(lecture => lecture.Title.Contains("history", StringComparison.OrdinalIgnoreCase) || lecture.Description.Contains("history", StringComparison.OrdinalIgnoreCase)).ToList(),
        "Speakers" => Lectures.Where(lecture => !string.IsNullOrWhiteSpace(lecture.Speaker)).ToList(),
        _ => Lectures
    };

    private async Task PlayLectureAsync(AudioStream lecture)
    {
        var playbackUrl = await LectureService.GetPlaybackUrl(lecture.Id);
        if (string.IsNullOrWhiteSpace(playbackUrl))
        {
            await JS.InvokeVoidAsync("alert", "This lecture is currently unavailable for playback.");
            return;
        }

        var playableTrack = CreatePlayableTrack(lecture, playbackUrl);
        AudioPlayer.PlayTrack(playableTrack);
        NavigationManager.NavigateTo("/nowplaying");
    }

    private static AudioStream CreatePlayableTrack(AudioStream original, string playbackUrl)
    {
        return new AudioStream
        {
            Id = original.Id,
            Title = original.Title,
            Description = original.Description,
            BlobUrl = playbackUrl,
            CreatedAt = original.CreatedAt,
            ScheduledAt = original.ScheduledAt,
            IsLive = original.IsLive,
            Speaker = original.Speaker,
            Duration = original.Duration
        };
    }









    private string GetFilterClass(string filter)
    {
        return CurrentFilter == filter
            ? "px-6 py-2 rounded-full bg-primary text-on-primary"
            : "px-6 py-2 rounded-full bg-surface-container-low text-secondary";
    }

    private Task CopyLectureLinkAsync(AudioStream lecture)
    {
        return JS.InvokeVoidAsync("voiceOfIslamStorage.copyText", lecture.BlobUrl).AsTask();
    }

    private string FormatDuration(TimeSpan duration)
    {
        return duration.TotalHours >= 1
            ? $"{(int)duration.TotalHours}:{duration.Minutes:D2}:{duration.Seconds:D2}"
            : $"{duration.Minutes:D2}:{duration.Seconds:D2}";
    }
}
