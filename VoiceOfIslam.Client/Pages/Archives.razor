<div class="flex items-center gap-3 mt-1">
<span class="text-secondary font-light text-xs uppercase tracking-[0.05em]">Shaykh Yasir Qadhi</span>
<span class="w-1 h-1 rounded-full bg-outline-variant"></span>
<span class="text-secondary font-light text-xs uppercase tracking-[0.05em]">1:15:20</span>
</div>
</div>
</div>
<div class="flex items-center gap-4 mt-4 md:mt-0 opacity-40 group-hover:opacity-100 transition-opacity">
<button class="material-symbols-outlined text-secondary hover:text-primary" data-icon="bookmark">bookmark</button>
<button class="material-symbols-outlined text-secondary hover:text-primary" data-icon="share">share</button>
<button class="w-10 h-10 rounded-full bg-primary/10 text-primary flex items-center justify-center" data-icon="play_arrow">
<span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">play_arrow</span>
</button>
</div>
</div>
<!-- Card 3 -->
<div class="bg-surface-container-lowest rounded-xl p-6 flex flex-col md:flex-row md:items-center justify-between hover:bg-surface-container-low transition-colors duration-300 group cursor-pointer border-none">
<div class="flex gap-6 items-center">
<div class="w-16 h-16 rounded-2xl bg-secondary-container flex items-center justify-center text-primary overflow-hidden">
<img class="w-full h-full object-cover" data-alt="vast night sky full of stars above a desert landscape, peaceful and awe-inspiring atmosphere" src="https://lh3.googleusercontent.com/aida-public/AB6AXuCl12jAhs8hNGyceFZarIVdNh5OJImHzVHh6bqM8Cl1vTynXkKrMBlM9vks1yySfWI5jHP2-ulhaaqTirIuHTMwGDHsCNQDskDy0VCHW6Q3KFOl7JaHjWb56S29CfakNDf26cMiI_gb6n5erx3bY4jgMnAKqnsDSYVpARN9CnaDi-eZN0hZEyXVEu6aDqSCp0iJ2nIDevNNLB-TrMSVb7k3juyZN940-f-32Qb4wMD5mtR_wyL_K0v7JmRij99EljJVjOjiYoTwJ8A"/>
</div>
<div>
<h4 class="font-headline font-bold text-lg text-on-surface group-hover:text-primary transition-colors">Finding Peace in Prayer</h4>
<div class="flex items-center gap-3 mt-1">
<span class="text-secondary font-light text-xs uppercase tracking-[0.05em]">Ustadh Nouman Ali Khan</span>
<span class="w-1 h-1 rounded-full bg-outline-variant"></span>
<span class="text-secondary font-light text-xs uppercase tracking-[0.05em]">24:45</span>
</div>
</div>
</div>
<div class="flex items-center gap-4 mt-4 md:mt-0 opacity-40 group-hover:opacity-100 transition-opacity">
<button class="material-symbols-outlined text-secondary hover:text-primary" data-icon="bookmark">bookmark</button>
<button class="material-symbols-outlined text-secondary hover:text-primary" data-icon="share">share</button>
<button class="w-10 h-10 rounded-full bg-primary/10 text-primary flex items-center justify-center" data-icon="play_arrow">
<span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">play_arrow</span>
</button>
</div>
</div>
</div>
</main>
