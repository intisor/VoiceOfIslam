@page "/nowplaying"
@implements IDisposable
@inject AudioPlayerService AudioPlayer
@inject NavigationManager NavigationManager

<PageTitle>Now Playing - Ohun Islam</PageTitle>

<!-- Global Grain Overlay -->
<div class="fixed inset-0 grain-texture z-[100]"></div>

<!-- TopAppBar -->
<header class="w-full top-0 sticky bg-[#fdf9f2] dark:bg-stone-950 flex justify-between items-center px-6 py-4 z-40 max-w-screen-md mx-auto">
    <button @onclick="GoBack" class="hover:opacity-80 transition-opacity flex items-center justify-center bg-transparent border-none">
        <span class="material-symbols-outlined text-[#416355] dark:text-[#6B8E7F] text-2xl">expand_more</span>
    </button>
    <h1 class="font-['Manrope'] font-bold text-lg uppercase tracking-widest text-on-surface">Now Playing</h1>
    <button class="hover:opacity-80 transition-opacity flex items-center justify-center bg-transparent border-none">
        <span class="material-symbols-outlined text-[#416355] dark:text-[#6B8E7F] text-2xl">more_vert</span>
    </button>
</header>
<main class="max-w-md mx-auto px-8 pt-6 pb-32 flex flex-col items-center">
    <!-- Large Immersive Cover Art -->
    <div class="w-full aspect-square mb-10 relative group">
        <div class="absolute inset-0 bg-primary opacity-5 blur-3xl rounded-full scale-90 translate-y-8"></div>
        <img alt="Lecture Cover" class="w-full h-full object-cover rounded-[2rem] shadow-2xl relative z-10" src="@(AudioPlayer.CurrentTrack?.BlobUrl ?? "https://lh3.googleusercontent.com/aida-public/AB6AXuCi4GpqmsZHkGJSBvyIKmdLd1xv4VjwO28HwEvJbbNdQslXHr6f0L_VJyASoC7l5ZvjR5xsw-F0I-XiTI09S0wfzZ-5cQNAzHdfmaVOOiaGnrg-7lEoSMONAp-5t0M5cRAHsMqRyVsgtDP3nBZZ5e0qR9eCcqI3pZcLV5xsSXCmONKRE3I6UeKGNMEWED1gNzmIHH5NyqdvlAHpP-yv6b0jnBNZ_yefP8ChGmeyxivErZsZGCHzWNFdtP5iumIfesjnWmVwT6OmRxs")" />
    </div>
    <!-- Lecture Metadata: Editorial Tension -->
    <div class="w-full mb-8 space-y-2">
        <h2 class="font-headline text-3xl font-extrabold tracking-tight text-on-surface leading-tight">
            @(AudioPlayer.CurrentTrack?.Title ?? "Select a track")
        </h2>
        <div class="flex items-center justify-between">
            <p class="font-body text-secondary font-medium tracking-wide">
                @(AudioPlayer.CurrentTrack?.Speaker ?? "Unknown Speaker")
            </p>
            <button class="text-primary hover:scale-110 transition-transform bg-transparent border-none">
                <span class="material-symbols-outlined">favorite</span>
            </button>
        </div>
    </div>
    <!-- Playback Progress -->
    <div class="w-full space-y-4 mb-10">
        <div class="relative h-1.5 w-full bg-surface-container-highest rounded-full overflow-hidden cursor-pointer">
            <div class="absolute h-full bg-primary rounded-full transition-all duration-300" style="width: @(AudioPlayer.Progress * 100)%"></div>
            <div class="absolute h-4 w-4 bg-primary border-[3px] border-surface rounded-full top-1/2 -translate-y-1/2 shadow-sm" style="left: @(AudioPlayer.Progress * 100)%"></div>
        </div>
        <div class="flex justify-between text-[10px] font-label font-medium tracking-widest text-secondary opacity-70">
            <span>@(FormatTime(AudioPlayer.Progress * (AudioPlayer.CurrentTrack?.Duration.TotalSeconds ?? 0)))</span>
            <span>@(FormatTime(AudioPlayer.CurrentTrack?.Duration.TotalSeconds ?? 0))</span>
        </div>
    </div>
    <!-- Control Cluster: Muted Sage and Tactile Shapes -->
    <div class="w-full flex flex-col gap-8">
        <!-- Primary Controls -->
        <div class="flex items-center justify-between px-4">
            <button class="text-on-surface-variant hover:opacity-70 transition-opacity bg-transparent border-none">
                <span class="material-symbols-outlined text-3xl">replay_5</span>
            </button>
            <div class="flex items-center gap-10">
                <button class="text-on-surface-variant hover:opacity-70 transition-opacity bg-transparent border-none">
                    <span class="material-symbols-outlined text-3xl">skip_previous</span>
                </button>
                <button @onclick="TogglePlay" class="w-20 h-20 bg-primary text-on-primary rounded-full flex items-center justify-center shadow-lg shadow-primary/20 hover:scale-105 active:scale-95 transition-all duration-300 border-none">
                    <span class="material-symbols-outlined text-5xl" style="font-variation-settings: 'FILL' 1;">@(AudioPlayer.IsPlaying ? "pause" : "play_arrow")</span>
                </button>
                <button class="text-on-surface-variant hover:opacity-70 transition-opacity bg-transparent border-none">
                    <span class="material-symbols-outlined text-3xl">skip_next</span>
                </button>
            </div>
            <button class="text-on-surface-variant hover:opacity-70 transition-opacity bg-transparent border-none">
                <span class="material-symbols-outlined text-3xl">forward_5</span>
            </button>
        </div>
        <!-- Tertiary Controls -->
        <div class="flex items-center justify-center gap-12 text-secondary pb-4">
            <button class="font-headline font-bold text-sm tracking-widest px-3 py-1 bg-surface-container-low rounded-lg hover:bg-surface-container-high transition-colors border-none">
                1.25x
            </button>
            <button class="hover:text-primary transition-colors bg-transparent border-none">
                <span class="material-symbols-outlined">share</span>
            </button>
            <button class="hover:text-primary transition-colors bg-transparent border-none">
                <span class="material-symbols-outlined">playlist_add</span>
            </button>
        </div>
    </div>
</main>

@code {
    protected override void OnInitialized()
    {
        AudioPlayer.OnStateChanged += StateHasChanged;
    }

    private void TogglePlay()
    {
        AudioPlayer.TogglePlay();
    }

    private void GoBack()
    {
        NavigationManager.NavigateTo("/");
    }

    private string FormatTime(double seconds)
    {
        var time = TimeSpan.FromSeconds(seconds);
        return $"{(int)time.TotalMinutes}:{time.Seconds:D2}";
    }

    public void Dispose()
    {
        AudioPlayer.OnStateChanged -= StateHasChanged;
    }
}
